# ── Model Configuration ────────────────────────────────────────────────────────
# Choose provider: "gemini" or "ollama"
MODEL_PROVIDER=gemini

# Gemini API Configuration (required if MODEL_PROVIDER=gemini)
# Get your API key from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Gemini model selection
GEMINI_MODEL=gemini-2.5-flash          # Fast, default remote model
GEMINI_PRO_MODEL=gemini-2.5-pro        # More capable, optional

# Ollama Configuration (required if MODEL_PROVIDER=ollama)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:30b                 # or try: llama3.3, gemma4

# ── Server Configuration ────────────────────────────────────────────────────────
PORT=8001

# ── Optional Settings ───────────────────────────────────────────────────────────
# Add more settings as needed
