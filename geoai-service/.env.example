# GeoAI Microservice Configuration
DEBUG=False
GEOAI_PORT=8002

# Optional: Copernicus Sentinel Hub credentials (for real satellite data)
# SENTINELHUB_CLIENT_ID=your_id
# SENTINELHUB_CLIENT_SECRET=your_secret

# Optional: Earth Engine API key
# GOOGLE_EARTH_ENGINE_KEY=your_key

# Optional: USGS Landscan API credentials
# USGS_API_KEY=your_key
